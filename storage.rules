rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User photo uploads for inspection and wallet documents
    match /uploads/{userId}/{fileName} {
      // Allow authenticated user to upload max 8MB images (jpeg, png, webp) to their folder
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 8 * 1024 * 1024
                   && (request.resource.contentType == 'image/jpeg'
                       || request.resource.contentType == 'image/png'
                       || request.resource.contentType == 'image/webp');

      // Allow authenticated users to view uploaded photos
      allow read: if request.auth != null;

      // Disallow public directory listing of storage folders
      allow list: if false;
    }

    // Garage commercial register photos
    match /garages/{garageId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == garageId
                   && request.resource.size <= 8 * 1024 * 1024
                   && (request.resource.contentType == 'image/jpeg'
                       || request.resource.contentType == 'image/png'
                       || request.resource.contentType == 'image/webp');
      allow read: if true;
      allow list: if false;
    }
  }
}
